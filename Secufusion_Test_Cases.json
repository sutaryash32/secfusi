	"item": [
		{
			"name": "01 — Auth Flow",
			"item": [
				{
					"name": "TC-001 Get Tenant Config (Public)",
					"event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Response time < 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));","pm.test('Has tenant config', () => {","    const j = pm.response.json();","    pm.expect(j).to.have.property('results');","    pm.expect(j.results).to.have.property('tenantId');","    pm.expect(j.results).to.have.property('clientId');","    pm.expect(j.results).to.have.property('ssoType');","    pm.expect(j.results.ssoType).to.be.oneOf(['AZURE','KEYCLOAK','APIKEY']);","});","pm.test('Save tenant_id', () => {","    const j = pm.response.json();","    if(j.results && j.results.tenantId){","        pm.collectionVariables.set('tenant_id', j.results.tenantId);","    }","});"]}}],
					"request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/iam/tenant-config?host={{tenant_host}}", "host": ["{{base_url}}"], "path": ["api","iam","tenant-config"], "query": [{"key": "host", "value": "{{tenant_host}}"}]}}
				},
				{
					"name": "TC-002 Tenant Config — Invalid Host",
					"event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Returns error for invalid host', () => {","    pm.expect(pm.response.code).to.be.oneOf([400,404,500]);","});","pm.test('Error message present', () => {","    const j = pm.response.json();","    const has = j.message || j.error || j.errorCode;","    pm.expect(has).to.not.be.undefined;","});"]}}],
					"request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/iam/tenant-config?host=nonexistent.invalid.com", "host": ["{{base_url}}"], "path": ["api","iam","tenant-config"], "query": [{"key": "host", "value": "nonexistent.invalid.com"}]}}
				},
				{
					"name": "TC-003 Tenant Config — Missing Host",
					"event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status 400 for missing param', () => {","    pm.expect(pm.response.code).to.be.oneOf([400,500]);","});"]}}],
					"request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/api/iam/tenant-config", "host": ["{{base_url}}"], "path": ["api","iam","tenant-config"]}}
				},
				{
					"name": "TC-004 Login with Valid Token",
					"event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Login returns user details', () => {","    const j = pm.response.json();","    pm.expect(j.results).to.have.property('userId');","    pm.expect(j.results).to.have.property('email');","    pm.expect(j.results).to.have.property('tenantId');","});","pm.test('Token saved', () => {","    const j = pm.response.json();","    pm.expect(j.results.token).to.be.a('string').and.not.empty;","    pm.collectionVariables.set('auth_token', j.results.token);","    pm.collectionVariables.set('user_id', j.results.userId);","    pm.collectionVariables.set('tenant_id', j.results.tenantId);","});"]}}],
					"request": {"method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"deviceFingerprint\": \"postman-test\",\n  \"deviceName\": \"Postman\",\n  \"deviceOS\": \"Test\",\n  \"browser\": \"Postman\",\n  \"ipAddress\": \"127.0.0.1\"\n}"}, "url": {"raw": "{{base_url}}/api/iam/login?token={{azure_jwt}}", "host": ["{{base_url}}"], "path": ["api","iam","login"], "query": [{"key": "token", "value": "{{azure_jwt}}"}]}}
				},
				{
					"name": "TC-005 Login — Invalid Token",
					"event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 401/403', () => {","    pm.expect(pm.response.code).to.be.oneOf([400,401,403,500]);","});","pm.test('No valid token returned', () => {","    const j = pm.response.json();","    if(j.results) pm.expect(j.results.token).to.be.undefined;","});"]}}],
					"request": {"method": "POST", "header": [], "url": {"raw": "{{base_url}}/api/iam/login?token=invalid.jwt.token", "host": ["{{base_url}}"], "path": ["api","iam","login"], "query": [{"key": "token", "value": "invalid.jwt.token"}]}}
				},
				{
					"name": "TC-006 Login — Empty Token",
					"event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Rejects empty token', () => {","    pm.expect(pm.response.code).to.be.oneOf([400,401,500]);","});"]}}],
					"request": {"method": "POST", "header": [], "url": {"raw": "{{base_url}}/api/iam/login?token=", "host": ["{{base_url}}"], "path": ["api","iam","login"], "query": [{"key": "token", "value": ""}]}}
				},
				{
					"name": "TC-007 SSO Login",
					"event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('SSO returns tenant info', () => {","    const j = pm.response.json();","    pm.expect(j.results).to.have.property('tenantId');","});"]}}],
					"request": {"method": "POST", "header": [], "url": {"raw": "{{base_url}}/api/iam/login/sso?token={{azure_jwt}}", "host": ["{{base_url}}"], "path": ["api","iam","login","sso"], "query": [{"key": "token", "value": "{{azure_jwt}}"}]}}
				}
			]
		},
