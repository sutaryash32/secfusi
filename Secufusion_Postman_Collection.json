{
	"info": {
		"_postman_id": "sfn-complete-collection-v1",
		"name": "Secufusion — Complete API Collection",
		"description": "Complete Postman collection for all Secufusion microservices (IAM, Tenants, Events).\n\nSetup:\n1. Import this collection\n2. Set environment variables: base_url, auth_token, tenant_host\n3. Run '0. Auth Flow > Get Tenant Config' first\n4. Then run 'Login' to set auth_token automatically\n5. All subsequent requests use {{auth_token}}",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8083",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "tenant_host",
			"value": "example.motivitylabs.net",
			"type": "string"
		},
		{
			"key": "tenant_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "role_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "group_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "package_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "feature_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "device_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "events_group_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "device_user_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "extension_key_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "session_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "sso_config_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Auth Flow",
			"description": "Authentication workflow — run these first in order",
			"item": [
				{
					"name": "1. Get Tenant Config (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/iam/tenant-config?host={{tenant_host}}",
							"host": ["{{base_url}}"],
							"path": ["api", "iam", "tenant-config"],
							"query": [{"key": "host", "value": "{{tenant_host}}"}]
						}
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"var jsonData = pm.response.json();",
								"if (jsonData.results && jsonData.results.tenantId) {",
								"    pm.collectionVariables.set('tenant_id', jsonData.results.tenantId);",
								"    console.log('Set tenant_id: ' + jsonData.results.tenantId);",
								"}",
								"pm.test('Tenant config retrieved', function() {",
								"    pm.response.to.have.status(200);",
								"    pm.expect(jsonData.results).to.have.property('clientId');",
								"});"
							],
							"type": "text/javascript"
						}
					}]
				},
				{
					"name": "2. Login (Azure JWT)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceFingerprint\": \"postman-test-fp\",\n  \"deviceName\": \"Postman\",\n  \"deviceOS\": \"Test\",\n  \"browser\": \"Postman\",\n  \"ipAddress\": \"127.0.0.1\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/iam/login?token=PASTE_YOUR_AZURE_JWT_HERE",
							"host": ["{{base_url}}"],
							"path": ["api", "iam", "login"],
							"query": [{"key": "token", "value": "PASTE_YOUR_AZURE_JWT_HERE"}]
						}
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"var jsonData = pm.response.json();",
								"if (jsonData.results && jsonData.results.token) {",
								"    pm.collectionVariables.set('auth_token', jsonData.results.token);",
								"    console.log('Auth token saved!');",
								"}",
								"if (jsonData.results && jsonData.results.tenantId) {",
								"    pm.collectionVariables.set('tenant_id', jsonData.results.tenantId);",
								"}",
								"if (jsonData.results && jsonData.results.userId) {",
								"    pm.collectionVariables.set('user_id', jsonData.results.userId);",
								"}",
								"pm.test('Login successful', function() {",
								"    pm.response.to.have.status(200);",
								"});"
							],
							"type": "text/javascript"
						}
					}]
				},
				{
					"name": "3. Extension Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/api/iam/login/extension?token=PASTE_JWT&deviceUserEmail=user@example.com",
							"host": ["{{base_url}}"],
							"path": ["api", "iam", "login", "extension"],
							"query": [
								{"key": "token", "value": "PASTE_JWT"},
								{"key": "deviceUserEmail", "value": "user@example.com"}
							]
						}
					}
				},
				{
					"name": "4. SSO Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/api/iam/login/sso?token=PASTE_JWT",
							"host": ["{{base_url}}"],
							"path": ["api", "iam", "login", "sso"],
							"query": [{"key": "token", "value": "PASTE_JWT"}]
						}
					}
				}
			]
		},
		{
			"name": "1. IAM — Users",
			"description": "User CRUD operations",
			"item": [
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": {"raw": "{{base_url}}/api/iam/users", "host": ["{{base_url}}"], "path": ["api", "iam", "users"]}
					}
				},
				{
					"name": "Get Users by Tenant",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": {"raw": "{{base_url}}/api/iam/users/tenant/{{tenant_id}}", "host": ["{{base_url}}"], "path": ["api", "iam", "users", "tenant", "{{tenant_id}}"]}
					}
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": {"raw": "{{base_url}}/api/iam/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api", "iam", "users", "{{user_id}}"]}
					}
				},
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"john.doe\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"role\": \"USER\"\n}"
						},
						"url": {"raw": "{{base_url}}/api/iam/users/{{tenant_id}}", "host": ["{{base_url}}"], "path": ["api", "iam", "users", "{{tenant_id}}"]}
					}
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Updated\",\n  \"phoneNumber\": \"+1987654321\"\n}"
						},
						"url": {"raw": "{{base_url}}/api/iam/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api", "iam", "users", "{{user_id}}"]}
					}
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": {"raw": "{{base_url}}/api/iam/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api", "iam", "users", "{{user_id}}"]}
					}
				},
				{
					"name": "Check User Uniqueness",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{auth_token}}"}],
						"url": {
							"raw": "{{base_url}}/api/iam/users/check?userName=john.doe&phoneNumber=%2B1234567890&email=john@example.com",
							"host": ["{{base_url}}"],
							"path": ["api", "iam", "users", "check"],
							"query": [
								{"key": "userName", "value": "john.doe"},
								{"key": "phoneNumber", "value": "+1234567890"},
								{"key": "email", "value": "john@example.com"}
							]
						}
					}
				}
			]
		},
